# LiveKit Cloud project settings (https://cloud.livekit.io → Project Settings)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Groq API key for the STT agent
GROQ_API_KEY=your_groq_api_key

# Backend URL used by the agent when both backend and agent run together
BACKEND_URL=http://127.0.0.1:8080

# Neon PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@host/db?sslmode=require

# Comma-separated allowed origins for the backend
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Agent name registered with LiveKit Cloud (must match agent/livekit.toml)
LIVEKIT_AGENT_NAME=stt-agent
