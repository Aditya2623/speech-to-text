# LiveKit Cloud (https://cloud.livekit.io → Project Settings)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Groq (https://www.groq.com/ → API Keys)
GROQ_API_KEY=your_groq_api_key

# Fly.io backend URL (no trailing slash)
BACKEND_URL=https://your-api.fly.dev

# Must match backend LIVEKIT_AGENT_NAME and livekit.toml
LIVEKIT_AGENT_NAME=stt-agent
