# Neon PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# LiveKit Cloud project settings (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Comma-separated allowed origins (your Vercel frontend URL)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Agent name registered with LiveKit Cloud (must match agent/livekit.toml)
LIVEKIT_AGENT_NAME=stt-agent
